{
  "name": "maeumjeongwon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "node tools/build-seo.js && node tools/build-worker.js",
    "build:seo": "node tools/build-seo.js",
    "build:worker": "node tools/build-worker.js",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "build:mobile": "node tools/build-mobile.js",
    "test": "node --test server/test/*.test.js",
    "test:content": "node tools/content-smoke.js",
    "test:temples": "node tools/temple-smoke.js",
    "budget": "node tools/payload-budget.js",
    "verify": "npm test && npm run test:content && npm run test:temples && npm run budget -- --check && npm run build",
    "push": "node tools/git-push.js",
    "start": "node server.js"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "compression": "^1.8.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
