# Session HMAC Secret (required in production, >= 32 chars)
SESSION_SECRET=
# RevenueCat Webhook Authorization Header (e.g. Bearer <secret>)
REVENUECAT_WEBHOOK_AUTH=
# AdMob Rewarded Ad Unit IDs (comma-separated)
ADMOB_AD_UNIT_IDS=
# Development flags (must NOT be enabled in NODE_ENV=production)
ALLOW_DEV_AD_REWARD=1
ALLOW_DEV_ENTITLEMENT=1
# API Base URL for mobile builds (https:// required for release)
MJ_API_BASE=
# SEO Static Build & Google AdSense / GA4 (optional)
SITE_URL=
ADSENSE_PUB_ID=
ADSENSE_TEMPLE_SLOT=
GA_MEASUREMENT_ID=



